{
  "name": "numi-adtech",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mac": "npm run build && electron-builder --mac",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.numiadtech.app",
    "productName": "Numi Ad-Tech",
    "files": [
      "out/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "mathjs": "^15.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
